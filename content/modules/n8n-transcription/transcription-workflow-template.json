{
  "name": "音声文字起こし",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "search",
        "queryString": "mimeType contains 'audio'",
        "folderId": {
          "__rl": true,
          "value": "【フォルダIDを入力】",
          "mode": "id"
        },
        "options": {}
      },
      "id": "search-audio",
      "name": "Search Audio Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [220, 0],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "【Credential IDを入力】",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "id": "loop-items",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "download-audio",
      "name": "Download Audio",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [660, 0],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "【Credential IDを入力】",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "fileName": "=/tmp/{{ $json.name }}",
        "dataPropertyName": "data"
      },
      "id": "save-temp",
      "name": "Save to Temp",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [880, 0]
    },
    {
      "parameters": {
        "command": "=/opt/whisper.cpp/build/bin/whisper-cli -m /opt/whisper.cpp/models/ggml-base.bin -l ja -otxt -of /tmp/output /tmp/{{ $('Save to Temp').item.json.fileName }}"
      },
      "id": "execute-whisper",
      "name": "Execute Whisper",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "filePath": "/tmp/output.txt"
      },
      "id": "read-result",
      "name": "Read Result",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{ $('Download Audio').item.json.name }}.txt",
        "folderId": {
          "__rl": true,
          "value": "【出力先フォルダIDを入力】",
          "mode": "id"
        },
        "options": {}
      },
      "id": "upload-drive",
      "name": "Upload to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1540, 0],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "【Credential IDを入力】",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "command": "rm -f /tmp/output.txt /tmp/*.mp3 /tmp/*.wav /tmp/*.m4a"
      },
      "id": "cleanup",
      "name": "Clean Up",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1760, 0]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Search Audio Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Audio Files": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [
          {
            "node": "Download Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Audio": {
      "main": [
        [
          {
            "node": "Save to Temp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Temp": {
      "main": [
        [
          {
            "node": "Execute Whisper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Whisper": {
      "main": [
        [
          {
            "node": "Read Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Result": {
      "main": [
        [
          {
            "node": "Upload to Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to Drive": {
      "main": [
        [
          {
            "node": "Clean Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean Up": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
