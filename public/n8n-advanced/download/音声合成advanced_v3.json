{
  "name": "音声合成advanced_v3",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1600, 400],
      "id": "trigger-001",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "YOUR_CANVA_A_GID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1360, 160],
      "id": "sheet-a",
      "name": "Get Sheet A"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "YOUR_CANVA_B_GID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1360, 320],
      "id": "sheet-b",
      "name": "Get Sheet B"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "YOUR_CANVA_C_GID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1360, 480],
      "id": "sheet-c",
      "name": "Get Sheet C"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "YOUR_CANVA_D_GID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1360, 640],
      "id": "sheet-d",
      "name": "Get Sheet D"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "YOUR_CANVA_E_GID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1360, 800],
      "id": "sheet-e",
      "name": "Get Sheet E"
    },
    {
      "parameters": {
        "jsCode": "// 各シートからデータを取得してカテゴリを付与\nconst sheetA = $('Get Sheet A').all().map(item => ({ json: { ...item.json, category: 'A' } }));\nconst sheetB = $('Get Sheet B').all().map(item => ({ json: { ...item.json, category: 'B' } }));\nconst sheetC = $('Get Sheet C').all().map(item => ({ json: { ...item.json, category: 'C' } }));\nconst sheetD = $('Get Sheet D').all().map(item => ({ json: { ...item.json, category: 'D' } }));\nconst sheetE = $('Get Sheet E').all().map(item => ({ json: { ...item.json, category: 'E' } }));\n\n// 全データを結合\nconst allData = [...sheetA, ...sheetB, ...sheetC, ...sheetD, ...sheetE];\n\n// audio_status === 'NORMAL' でフィルタ\nconst filtered = allData.filter(item => item.json.audio_status === 'NORMAL');\n\nif (filtered.length === 0) {\n  return [{ json: { message: 'No items to process', count: 0 } }];\n}\n\n// 年月日を生成（フォルダ名用）\nconst now = new Date();\nconst yearMonthDay = now.getFullYear().toString() + \n  String(now.getMonth() + 1).padStart(2, '0') + \n  String(now.getDate()).padStart(2, '0');\n\n// 各アイテムにフォルダ名を付与\nreturn filtered.map(item => ({\n  json: {\n    ...item.json,\n    folder_name: `${yearMonthDay}投稿${item.json.category}`,\n    archive_folder_name: `${yearMonthDay}投稿${item.json.category}_archive`\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1040, 400],
      "id": "merge-all",
      "name": "Merge All and Filter"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "not-empty-message",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-800, 400],
      "id": "if-has-items",
      "name": "If Has Items"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-560, 400],
      "id": "loop-items",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "={{ $json.folder_name }}",
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_PARENT_FOLDER_ID",
            "mode": "id"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-320, 400],
      "id": "search-category-folder",
      "name": "Search Category Folder",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "={{ $('Loop Over Items').item.json.archive_folder_name }}",
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_PARENT_FOLDER_ID",
            "mode": "id"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-80, 400],
      "id": "search-archive-folder",
      "name": "Search Archive Folder",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "archive-not-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [160, 400],
      "id": "if-archive-exists",
      "name": "If Archive Exists"
    },
    {
      "parameters": {
        "resource": "folder",
        "name": "={{ $('Loop Over Items').item.json.archive_folder_name }}",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "YOUR_PARENT_FOLDER_ID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [400, 280],
      "id": "create-archive-folder",
      "name": "Create Archive Folder"
    },
    {
      "parameters": {
        "jsCode": "// Loop Over Itemsから現在のアイテムを取得\nconst currentItem = $('Loop Over Items').item.json;\n\n// Search Category Folderからフォルダ情報を取得（名前が完全一致するもの）\nconst categoryFolders = $('Search Category Folder').all();\nconst categoryFolder = categoryFolders.find(f => f.json.name === currentItem.folder_name);\nconst categoryFolderId = categoryFolder ? categoryFolder.json.id : null;\n\n// アーカイブフォルダIDを取得\nlet archiveFolderId = null;\n\n// まずSearch Archive Folderから検索\nconst archiveFolders = $('Search Archive Folder').all();\nconst archiveFolder = archiveFolders.find(f => f.json.name === currentItem.archive_folder_name);\n\nif (archiveFolder && archiveFolder.json.id) {\n  archiveFolderId = archiveFolder.json.id;\n} else {\n  // 作成されたフォルダから取得を試みる\n  try {\n    const created = $('Create Archive Folder').first();\n    if (created && created.json.id) {\n      archiveFolderId = created.json.id;\n    }\n  } catch (e) {\n    // 作成されていない場合は無視\n  }\n}\n\nreturn [{\n  json: {\n    ...currentItem,\n    category_folder_id: categoryFolderId,\n    archive_folder_id: archiveFolderId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 400],
      "id": "prepare-item",
      "name": "Prepare Item Data"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "={{ $json.post_id }}",
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "={{ $json.category_folder_id }}",
            "mode": "id"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [880, 400],
      "id": "search-video",
      "name": "Search Video File",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "video-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 400],
      "id": "if-video-exists",
      "name": "If Video Exists"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $('Search Video File').item.json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1360, 280],
      "id": "download-video",
      "name": "Download Video"
    },
    {
      "parameters": {
        "jsCode": "// Prepare Item Dataから現在のアイテムを取得\nconst item = $('Prepare Item Data').item.json;\nconst narration1 = item.narration_1 || '';\nconst narration2 = item.narration_2 || '';\nconst mergedNarration = narration1 + '\\n' + narration2;\n\nreturn [{\n  json: {\n    ...item,\n    narration: mergedNarration\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 280],
      "id": "merge-narrations",
      "name": "Merge Narrations"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fish.audio/v1/tts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.narration, reference_id: 'YOUR_VOICE_ID' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1840, 280],
      "id": "generate-audio",
      "name": "Generate Audio"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/tmp/video.mp4",
        "dataPropertyName": "={{ $('Download Video').first().binary.data }}",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [2080, 280],
      "id": "save-video",
      "name": "Save Video"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/tmp/audio.mp3",
        "dataPropertyName": "={{ $('Generate Audio').first().binary.data }}",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [2320, 280],
      "id": "save-audio",
      "name": "Save Audio"
    },
    {
      "parameters": {
        "command": "=ffmpeg -y -i /tmp/video.mp4 -i /tmp/audio.mp3 -filter_complex '[1:a]adelay=3000|3000[aout]' -map 0:v -map '[aout]' -c:v copy -c:a aac /tmp/output.mp4"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2560, 280],
      "id": "ffmpeg-merge",
      "name": "FFmpeg Merge"
    },
    {
      "parameters": {
        "fileSelector": "/tmp/output.mp4",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [2800, 280],
      "id": "read-output",
      "name": "Read Output"
    },
    {
      "parameters": {
        "operation": "move",
        "fileId": {
          "__rl": true,
          "value": "={{ $('Search Video File').item.json.id }}",
          "mode": "id"
        },
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $('Prepare Item Data').item.json.archive_folder_id }}",
          "mode": "id"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [3040, 400],
      "id": "move-to-archive",
      "name": "Move Original to Archive"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [3040, 280],
      "id": "wait-5s",
      "name": "Wait 5s",
      "webhookId": "wait-5s-id"
    },
    {
      "parameters": {
        "name": "={{ $('Search Video File').item.json.name }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $('Prepare Item Data').item.json.category_folder_id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [3280, 280],
      "id": "upload-new-video",
      "name": "Upload New Video"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_GAS_DEPLOY_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"updateAudioStatus\",\n  \"postId\": \"{{ $('Prepare Item Data').item.json.post_id }}\",\n  \"category\": \"{{ $('Prepare Item Data').item.json.category }}\",\n  \"status\": \"DONE\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [3520, 280],
      "id": "update-status",
      "name": "Update audio_status"
    },
    {
      "parameters": {
        "jsCode": "// 処理完了のログ\nconst item = $('Prepare Item Data').item.json;\nreturn [{\n  json: {\n    status: 'completed',\n    post_id: item.post_id,\n    category: item.category\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3760, 280],
      "id": "log-complete",
      "name": "Log Complete"
    },
    {
      "parameters": {
        "jsCode": "// ビデオが見つからなかった場合のスキップログ\nconst item = $('Prepare Item Data').item.json;\nreturn [{\n  json: {\n    status: 'skipped',\n    reason: 'video_not_found',\n    post_id: item.post_id,\n    category: item.category\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 520],
      "id": "skip-no-video",
      "name": "Skip - No Video"
    }
  ],
  "pinData": {},
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {"node": "Get Sheet A", "type": "main", "index": 0},
          {"node": "Get Sheet B", "type": "main", "index": 0},
          {"node": "Get Sheet C", "type": "main", "index": 0},
          {"node": "Get Sheet D", "type": "main", "index": 0},
          {"node": "Get Sheet E", "type": "main", "index": 0}
        ]
      ]
    },
    "Get Sheet A": {
      "main": [[{"node": "Merge All and Filter", "type": "main", "index": 0}]]
    },
    "Get Sheet B": {
      "main": [[{"node": "Merge All and Filter", "type": "main", "index": 0}]]
    },
    "Get Sheet C": {
      "main": [[{"node": "Merge All and Filter", "type": "main", "index": 0}]]
    },
    "Get Sheet D": {
      "main": [[{"node": "Merge All and Filter", "type": "main", "index": 0}]]
    },
    "Get Sheet E": {
      "main": [[{"node": "Merge All and Filter", "type": "main", "index": 0}]]
    },
    "Merge All and Filter": {
      "main": [[{"node": "If Has Items", "type": "main", "index": 0}]]
    },
    "If Has Items": {
      "main": [
        [{"node": "Loop Over Items", "type": "main", "index": 0}],
        []
      ]
    },
    "Loop Over Items": {
      "main": [
        [],
        [{"node": "Search Category Folder", "type": "main", "index": 0}]
      ]
    },
    "Search Category Folder": {
      "main": [[{"node": "Search Archive Folder", "type": "main", "index": 0}]]
    },
    "Search Archive Folder": {
      "main": [[{"node": "If Archive Exists", "type": "main", "index": 0}]]
    },
    "If Archive Exists": {
      "main": [
        [{"node": "Create Archive Folder", "type": "main", "index": 0}],
        [{"node": "Prepare Item Data", "type": "main", "index": 0}]
      ]
    },
    "Create Archive Folder": {
      "main": [[{"node": "Prepare Item Data", "type": "main", "index": 0}]]
    },
    "Prepare Item Data": {
      "main": [[{"node": "Search Video File", "type": "main", "index": 0}]]
    },
    "Search Video File": {
      "main": [[{"node": "If Video Exists", "type": "main", "index": 0}]]
    },
    "If Video Exists": {
      "main": [
        [{"node": "Download Video", "type": "main", "index": 0}],
        [{"node": "Skip - No Video", "type": "main", "index": 0}]
      ]
    },
    "Skip - No Video": {
      "main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]
    },
    "Download Video": {
      "main": [[{"node": "Merge Narrations", "type": "main", "index": 0}]]
    },
    "Merge Narrations": {
      "main": [[{"node": "Generate Audio", "type": "main", "index": 0}]]
    },
    "Generate Audio": {
      "main": [[{"node": "Save Video", "type": "main", "index": 0}]]
    },
    "Save Video": {
      "main": [[{"node": "Save Audio", "type": "main", "index": 0}]]
    },
    "Save Audio": {
      "main": [[{"node": "FFmpeg Merge", "type": "main", "index": 0}]]
    },
    "FFmpeg Merge": {
      "main": [[{"node": "Read Output", "type": "main", "index": 0}]]
    },
    "Read Output": {
      "main": [
        [
          {"node": "Move Original to Archive", "type": "main", "index": 0},
          {"node": "Wait 5s", "type": "main", "index": 0}
        ]
      ]
    },
    "Wait 5s": {
      "main": [[{"node": "Upload New Video", "type": "main", "index": 0}]]
    },
    "Upload New Video": {
      "main": [[{"node": "Update audio_status", "type": "main", "index": 0}]]
    },
    "Update audio_status": {
      "main": [[{"node": "Log Complete", "type": "main", "index": 0}]]
    },
    "Log Complete": {
      "main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
